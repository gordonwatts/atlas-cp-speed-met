--- /dev/null
+++ b/components/columnar/M27.md
@@ -0,0 +1,52 @@
+# M27 jet track-count offset validation
+
+The production diff changes only the lifetime of the checked `jet.ntrk.o`
+view. The full event entry owns one optional view per chunk. It performs the
+original first access from `prepare_views`, after the flat `jet.ntrk` lookup
+and before preparing objects. An empty chunk never binds the fields. Each
+jet still goes through the existing row and flat-length checks when reached,
+including rows with duplicated offsets. Jet sampling uses the original path.
+
+Build the normal immutable trial as before. The default library has no counters
+or fixture symbols. Build a separate untimed receipt with the same source and
+toolchain settings, adding only `-DATLAS_MET_M27_DIAGNOSTICS=ON`. For example,
+from a fresh pinned release build shell after setting `snapshot` to the normal
+immutable M27 archive and `diagnostic` to a new result directory:
+
+```bash
+repo=$PWD
+sdk="$repo/vendor/correctionlib-exact-001"
+core="$repo/results/core-exact-build-001/install/correctionlib"
+lwtnn="$repo/results/core-exact-build-001/build/lwtnn/lib/liblwtnn-stat.a"
+jvt=/home/gwatts/atlas-cp-speed/jets-skill-c8a2374-20261117/provider
+source="$snapshot/source/components/columnar"
+runtime="$diagnostic/runtime"
+mkdir -- "$diagnostic"
+taskset -c 0 cmake -S "$source" -B "$diagnostic/build" \
+    -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=23 -DCMAKE_CXX_STANDARD_REQUIRED=ON \
+    -Dcorrectionlib_DIR="$core/cmake" -DATLAS_MET_PINNED_SDK="$sdk" \
+    -DATLAS_MET_LWTNN="$lwtnn" -DATLAS_MET_SMALL_JVT="$jvt" \
+    -DATLAS_MET_COLUMNAR_PREPARATION=ON -DATLAS_MET_M27_DIAGNOSTICS=ON
+taskset -c 0 cmake --build "$diagnostic/build" --parallel 1
+cmake --install "$diagnostic/build" --prefix "$runtime"
+cp "$snapshot/runtime/native"/lib{correctionlib.so,stdc++.so.6,gcc_s.so.1} "$runtime/native/"
+cp -a "$snapshot/runtime/payloads" "$runtime/payloads"
+env LD_LIBRARY_PATH="$runtime/native" taskset -c 0 \
+    "$python314" "$source/check_ntrk_offsets.py" "$runtime/native/libatlas_met_columnar.so"
+env LD_LIBRARY_PATH="$runtime/native" taskset -c 0 \
+    "$python314" "$source/met_demo.py" "$input" "$diagnostic/c.npz" \
+    --runtime "$runtime" --stop 16 --chunk-size 7 --trace "$diagnostic/trace.tsv"
+env LD_LIBRARY_PATH="$runtime/native" taskset -c 0 \
+    "$python314" "$source/check_ntrk_offsets.py" "$runtime/native/libatlas_met_columnar.so" \
+    --trace "$diagnostic/trace.tsv" --entries 16 --chunk-size 7
+```
+
+The fixture exercises empty and nonempty chunks, missing field precedence,
+duplicate and decreasing offsets, and an out-of-range row following a valid
+row. The diagnostic trace writes one row at the end of each completed chunk
+with its starting entry, size and observed constructor call count. The prefix
+above expects three calls for chunks of seven, seven and two entries. The
+existing trace comparator can ignore this diagnostic action while validating
+all physics rows. Keep the diagnostic library out of production timing and
+distribution. Use the unchanged full tuple and physics comparisons before
+timing the normal trial artifact.
diff --git a/components/columnar/check_ntrk_offsets.py b/components/columnar/check_ntrk_offsets.py
new file mode 100644
index 0000000..92da0b5
--- /dev/null
+++ b/components/columnar/check_ntrk_offsets.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Run the M27 C++ fixture and check constructor calls in an untimed C trace."""
+import ctypes as c
+import json
+from pathlib import Path
+
+import typer
+
+
+def main(diagnostic_library: Path, trace: Path | None = None,
+         entries: int = typer.Option(16,min=0), chunk_size: int = typer.Option(7,min=1)):
+    module = c.CDLL(str(diagnostic_library.resolve(strict=True)))
+    module.met_columnar_error.argtypes = ()
+    module.met_columnar_error.restype = c.c_char_p
+    module.met_check_jet_ntrk_offsets.argtypes = ()
+    module.met_check_jet_ntrk_offsets.restype = c.c_int
+    if module.met_check_jet_ntrk_offsets() != 0:
+        raise RuntimeError(module.met_columnar_error().decode())
+    observed = []
+    if trace is not None:
+        with trace.open() as handle:
+            for line in handle:
+                entry,state,action,*values = line.rstrip("\n").split("\t")
+                if action == "ntrkOffsetConstructorCalls":
+                    observed.append((int(entry),int(state),*map(int,values)))
+        expected = [(end-1,0,begin,end-begin,1)
+                    for begin in range(0,entries,chunk_size) for end in [min(begin+chunk_size,entries)]]
+        if observed != expected:
+            raise ValueError(f"Unexpected jet.ntrk.o constructor calls {observed}, expected {expected}")
+    print(json.dumps({"synthetic_cases":"passed","chunk_constructor_calls":observed}))
+
+
+if __name__ == "__main__":
+    typer.run(main)
diff --git a/components/columnar/m27_offsets_check.inc b/components/columnar/m27_offsets_check.inc
new file mode 100644
index 0000000..1f201d9
--- /dev/null
+++ b/components/columnar/m27_offsets_check.inc
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: Apache-2.0
+// Included only by the untimed M27 diagnostic library.
+extern "C" int met_check_jet_ntrk_offsets()
+{
+    try {
+        const auto require=[](bool condition,const char* message) {
+            if (!condition) throw std::logic_error(message);
+        };
+        const auto require_error=[]<class Error>(auto&& operation,std::string_view message,
+                                                 std::type_identity<Error>) {
+            try {
+                operation();
+            } catch (const Error& error) {
+                if (std::string_view(error.what())!=message) throw;
+                return;
+            }
+            throw std::logic_error("Expected track-count offset validation failure");
+        };
+        constexpr auto invalid=std::type_identity<std::invalid_argument>{};
+        constexpr auto range=std::type_identity<std::out_of_range>{};
+        constexpr auto missing_values="Missing or mistyped flat buffer jet.ntrk";
+        constexpr auto missing_offsets="Missing or mistyped flat buffer jet.ntrk.o";
+        constexpr auto malformed="Invalid jagged offsets jet.ntrk.o";
+        constexpr auto outside="Jagged row outside flat buffer";
+
+        const Columns absent(std::span<const MetColumn>{});
+        ChunkJetTrackCounts empty_chunk;
+        require(empty_chunk.constructor_calls()==0,"An empty chunk validated track offsets");
+        require_error([&] { empty_chunk.bind(absent); },missing_values,invalid);
+        require(empty_chunk.constructor_calls()==0,"Missing values did not win before offset validation");
+
+        const std::array values{std::int32_t{5},std::int32_t{7},std::int32_t{11}};
+        const MetColumn flat{"jet.ntrk","i4",values.size(),values.data()};
+        const std::array missing_specs{flat};
+        const Columns missing(missing_specs);
+        ChunkJetTrackCounts no_offsets;
+        require_error([&] { no_offsets.bind(missing); },missing_offsets,invalid);
+        require(no_offsets.constructor_calls()==1,"Missing offsets should be checked on first bind");
+
+        const auto offsets_column=[](auto& offsets) {
+            return MetColumn{"jet.ntrk.o","i8",offsets.size(),offsets.data()};
+        };
+        const std::array<std::int64_t,1> no_jet_offsets{0};
+        const std::array no_jet_specs{MetColumn{"jet.ntrk","i4",0,nullptr},offsets_column(no_jet_offsets)};
+        const Columns no_jets(no_jet_specs);
+        ChunkJetTrackCounts no_jet_chunk;
+        no_jet_chunk.bind(no_jets);
+        no_jet_chunk.bind(no_jets);
+        require(no_jet_chunk.constructor_calls()==1,"A nonempty chunk with no jets should validate once");
+
+        const std::array<std::int64_t,4> offsets{0,2,2,3};
+        const std::array good_specs{flat,offsets_column(offsets)};
+        const Columns good(good_specs);
+        ChunkJetTrackCounts good_chunk;
+        {
+            const auto [storage,rows]=good_chunk.bind(good);
+            const auto first=rows.row(storage,0);
+            require(first.size()==2 && first[0]==5 && first[1]==7,"First track-count row");
+            require(rows.row(storage,1).empty(),"Duplicate offsets must give an empty row");
+            require(rows.row(storage,2).size()==1 && rows.row(storage,2).front()==11,"Last track-count row");
+            const auto [again_storage,again_rows]=good_chunk.bind(good);
+            require(again_storage.data()==storage.data() && &again_rows==&rows &&
+                    good_chunk.constructor_calls()==1,"Repeated event should retain the validated view");
+        }
+        ChunkJetTrackCounts next_chunk;
+        next_chunk.bind(good);
+        require(next_chunk.constructor_calls()==1,"Next chunk should validate its own offsets");
+
+        const std::array<std::int64_t,3> decreasing{0,2,1};
+        const std::array malformed_specs{flat,offsets_column(decreasing)};
+        const Columns bad(malformed_specs);
+        ChunkJetTrackCounts bad_chunk;
+        require_error([&] { bad_chunk.bind(bad); },malformed,invalid);
+        require(bad_chunk.constructor_calls()==1,"Decreasing offsets validation count");
+
+        const std::array empty_specs{flat,MetColumn{"jet.ntrk.o","i8",0,nullptr}};
+        const Columns no_offset_rows(empty_specs);
+        ChunkJetTrackCounts empty_offsets;
+        require_error([&] { empty_offsets.bind(no_offset_rows); },malformed,invalid);
+
+        const std::array<std::int64_t,3> long_offsets{0,1,4};
+        const std::array long_specs{flat,offsets_column(long_offsets)};
+        const Columns too_long(long_specs);
+        ChunkJetTrackCounts excess;
+        const auto [storage,rows]=excess.bind(too_long);
+        require(rows.row(storage,0).size()==1 && rows.row(storage,0).front()==5,
+                "A later out-of-range row must not move ahead of earlier valid rows");
+        require_error([&] { rows.row(storage,1); },outside,range);
+        require_error([&] { rows.row(storage,2); },outside,range);
+        require(excess.constructor_calls()==1,"Per-row range failure must not revalidate offsets");
+        return 0;
+    } catch (const std::exception& error) {
+        error_message=error.what();
+        return 1;
+    }
+}
