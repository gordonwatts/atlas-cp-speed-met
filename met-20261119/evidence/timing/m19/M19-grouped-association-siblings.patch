@@ -235,5 +235,18 @@ ASSOC_FIELDS = (
 
 def read_associations(tree, start, stop):
     parent = tree[ASSOC]
-    return {field: parent[ASSOC+field].array(entry_start=start, entry_stop=stop, library="ak")
-            for field in ASSOC_FIELDS}
+    names = [ASSOC + field for field in ASSOC_FIELDS]
+    try:
+        children = (parent[name] for name in names)
+        entries = parent.num_entries
+        ordinary = all(branch.parent is parent and not branch.branches and branch.num_entries == entries
