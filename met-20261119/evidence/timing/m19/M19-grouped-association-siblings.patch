diff --git a/components/columnar/test_association_projection.py b/components/columnar/test_association_projection.py
new file mode 100644
index 0000000..7011553
--- /dev/null
+++ b/components/columnar/test_association_projection.py
@@ -0,0 +1,133 @@
+"""Compare the association read path with separate sibling calls."""
+
+import os
+import unittest
+
+import awkward as ak
+import numpy as np
+import uproot
+
+from atlas_met_columnar import ASSOC, ASSOC_FIELDS, read_associations
+
+OBJECT_LINKS = ASSOC + "objectLinks"
+
+
+class Branch:
+    def __init__(self, parent, name, values, children=()):
+        self.parent = parent
+        self.name = name
+        self.values = values
+        self.num_entries = 4
+        self.branches = children
+
+    def array(self, *, entry_start, entry_stop, library):
+        self.parent.array_calls.append((self.name, entry_start, entry_stop, library))
+        return self.values[entry_start:min(entry_stop, self.num_entries)]
+
+
+class AssociationParent:
+    def __init__(self, split=False, missing=None):
+        self.group_calls = []
+        self.array_calls = []
+        self.num_entries = 4
+        links = ak.Array([
+            [],
+            [[], [{"m_persKey": 12345, "m_persIndex": 1},
+                  {"m_persKey": 0, "m_persIndex": 0},
+                  {"m_persKey": 5678, "m_persIndex": 0xffffffff}], []],
+            [[]],
+            [],
+        ])
+        links = ak.values_astype(links, np.uint32)
+        values = ak.Array([[], [1., 2., 3.], [4.], []])
+        self.children = {
+            ASSOC + field: Branch(self, ASSOC + field, links if field == "objectLinks" else values)
+            for field in ASSOC_FIELDS if field != missing
+        }
+        self.children[ASSOC + "jetLink"] = Branch(self, ASSOC + "jetLink", None)
+        if split:
+            self.children[OBJECT_LINKS].branches = ("m_persKey", "m_persIndex")
+
+    def __getitem__(self, qualified):
+        return self.children[qualified]
+
+    def arrays(self, expressions, *, entry_start, entry_stop, library, how):
+        self.group_calls.append((expressions, entry_start, entry_stop, library, how))
+        return {name: self.children[name].values[entry_start:entry_stop] for name in expressions}
+
+
+def separate(parent, start, stop):
+    return {field: parent[ASSOC + field].array(entry_start=start, entry_stop=stop, library="ak")
+            for field in ASSOC_FIELDS}
+
+
+class AssociationProjection(unittest.TestCase):
+    def assert_same(self, observed, expected):
+        self.assertEqual(tuple(observed), ASSOC_FIELDS)
+        self.assertEqual(tuple(expected), ASSOC_FIELDS)
+        for field in ASSOC_FIELDS:
+            with self.subTest(field=field):
+                of, ol, ob = ak.to_buffers(ak.to_packed(observed[field]))
+                ef, el, eb = ak.to_buffers(ak.to_packed(expected[field]))
+                self.assertEqual(of, ef)
+                self.assertEqual(ol, el)
+                self.assertEqual(set(ob), set(eb))
+                for key in ob:
+                    self.assertEqual(ob[key].dtype, eb[key].dtype)
+                    self.assertEqual(ob[key].tobytes(), eb[key].tobytes())
+
+    def test_grouped_siblings_preserve_typed_nested_records_and_empty_slice(self):
+        for start, stop in ((0, 4), (1, 3), (1, 1)):
+            with self.subTest(start=start, stop=stop):
+                parent = AssociationParent()
+                result = read_associations({ASSOC: parent}, start, stop)
+                self.assertEqual(parent.array_calls, [])
+                self.assertEqual(parent.group_calls, [
+                    ([ASSOC + field for field in ASSOC_FIELDS], start, stop, "ak", dict),
+                ])
+                self.assert_same(result, separate(parent, start, stop))
+                self.assertEqual(ak.fields(result["objectLinks"]), ["m_persKey", "m_persIndex"])
+
+    def test_split_sibling_uses_original_array_selection_shape(self):
+        parent = AssociationParent(split=True)
+        result = read_associations({ASSOC: parent}, 1, 3)
+        self.assertEqual(parent.group_calls, [])
+        self.assertEqual([row[0] for row in parent.array_calls], [ASSOC + f for f in ASSOC_FIELDS])
+        self.assert_same(result, separate(AssociationParent(split=True), 1, 3))
+
+    def test_misaligned_sibling_keeps_its_original_entry_shape(self):
+        parent = AssociationParent()
+        parent.children[OBJECT_LINKS].num_entries = 3
+        result = read_associations({ASSOC: parent}, 1, 4)
+        self.assertEqual(parent.group_calls, [])
+        self.assertEqual(len(result["objectLinks"]), 2)
+        self.assertEqual(len(result["isMisc"]), 3)
+        self.assert_same(result, separate(parent, 1, 4))
+
+    def test_missing_required_sibling_keeps_original_failure(self):
+        parent = AssociationParent(missing="overlapIndices")
+        with self.assertRaises(KeyError) as error:
+            read_associations({ASSOC: parent}, 1, 3)
+        self.assertEqual(error.exception.args, (ASSOC + "overlapIndices",))
+        self.assertEqual(parent.group_calls, [])
+        self.assertEqual([row[0] for row in parent.array_calls], [ASSOC + "isMisc", OBJECT_LINKS])
+
+    @unittest.skipUnless(os.environ.get("ATLAS_MET_ASSOC_PILOT"), "Set ATLAS_MET_ASSOC_PILOT to original PHYSLITE")
+    def test_original_siblings_across_object_link_basket_boundary(self):
+        original = os.environ["ATLAS_MET_ASSOC_PILOT"]
+        options = {"handler": uproot.source.file.MemmapSource, "num_workers": 1, "num_fallback_workers": 1}
+        with uproot.open(original, **options) as stock:
+            self.assertEqual(str(stock.file.uuid), "79ee6652-311f-11f1-aa37-0445010abeef")
+            tree = stock["CollectionTree"]
+            parent = tree[ASSOC]
+            for field in ASSOC_FIELDS:
+                branch = parent[ASSOC + field]
+                self.assertIs(branch.parent, parent)
+                self.assertFalse(branch.branches)
+                self.assertEqual(branch.num_entries, parent.num_entries)
+            offsets = parent[OBJECT_LINKS].entry_offsets
+            boundary = next(offset for offset in offsets[1:-1] if 2 <= offset <= tree.num_entries-2)
+            expected = separate(parent, boundary-2, boundary+2)
+        with uproot.open(original, **options) as candidate:
+            observed = read_associations(candidate["CollectionTree"], boundary-2, boundary+2)
+            self.assert_same(observed, expected)

